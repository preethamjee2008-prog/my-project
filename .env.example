# ASTRA VISION Environment Configuration
# Built by Preetham Alawandimath

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://*.vercel.app","https://*.luch.dev"]

# Inference Mode Settings
# MODE A: Remote Inference Endpoint
INFERENCE_API_URL=
INFERENCE_API_KEY=

# MODE B: Local Model Weights (Kept outside git repository)
DETECTOR_MODEL_PATH=
CLASSIFIER_MODEL_PATH=
YOLO_MODEL=yolov8n.pt
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.50
MAX_DETECTIONS=10

# MODE C: Demo Mode (Active when MODE A and MODE B are unconfigured)
# Demo mode uses authentic benchmark sample telemetry with explicit DEMO indicators.
